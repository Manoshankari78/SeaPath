# Copy to backend/.env (or export these as real env vars).
# Every value below has a working default — the app runs with no .env at all.

# --- Database --------------------------------------------------------------
# Omit to use the zero-setup SQLite default (backend/seapath.db).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/seapath

# --- Security --------------------------------------------------------------
# Change this to a long random value in any real deployment.
SECRET_KEY=dev-only-secret-change-me-in-production

ALLOWED_ORIGINS=http://localhost:5173

# --- Live vessel tracking --------------------------------------------------
# AIS_PROVIDER selects where vessel positions come from:
#   mock -> SeaPath's built-in voyage simulator. Positions are generated by
#           moving the ship along its calculated route. Always flagged as
#           simulated in the API and labelled "DEMO SIMULATION" in the UI.
#   real -> a commercial AIS feed (see app/services/ais/real_provider.py).
AIS_PROVIDER=mock

# Seconds between position pushes over the WebSocket / polling fallback.
LOCATION_UPDATE_INTERVAL=5

# Master switch. When false, tracking endpoints return 503 and the UI hides
# live-tracking controls. Route planning, fleet and voyages are unaffected.
ENABLE_LIVE_TRACKING=true

# Minimum seconds between writing a position row to the database. Decoupled
# from the push interval so a 5s live feed doesn't store 720 rows an hour.
POSITION_PERSIST_INTERVAL_S=60

# Maximum historical positions returned by /api/vessels/{id}/track.
MAX_TRACK_POINTS=500

# Significant wave height (m) at the vessel's live position that raises a
# StormWarning through the existing alert system, and the repeat cooldown.
LIVE_ALERT_WAVE_HEIGHT_M=4.0
LIVE_ALERT_COOLDOWN_S=1800

# --- Real AIS provider (only needed when AIS_PROVIDER=real) ----------------
# Never commit real credentials. Leave blank for the default mock provider.
# AIS_API_URL=https://your-ais-vendor.example.com/v1/vessels
# AIS_API_KEY=
