# Copy to backend/.env (or export these as real env vars) to run against
# PostgreSQL + PostGIS instead of the zero-setup SQLite default.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/seapath

# Change this to a long random value in any real deployment.
SECRET_KEY=dev-only-secret-change-me-in-production

ALLOWED_ORIGINS=http://localhost:5173
